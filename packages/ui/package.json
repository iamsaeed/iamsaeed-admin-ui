{
  "name": "@iamsaeed/admin-ui",
  "version": "0.6.0",
  "type": "module",
  "description": "Runtime-skinnable Vue 3 admin design system — tokens, shell, primitives, views",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/admin-ui.js",
  "module": "./dist/admin-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/admin-ui.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./styles": "./src/styles/index.css",
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "prepare": "npm run build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4"
  }
}
